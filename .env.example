# SherlysOS local environment.
# Copy the VITE_ values to .env.local. Keep the server values in .env.
# Do not commit real keys.

# Browser configuration. Vite exposes only VITE_ variables to the app.
# The publishable key is the current name for the anon key.
# Dashboard: Project Settings → API Keys.
#
# Netlify development site: Site configuration → Environment variables.
# Set the same two names there. Do not invent or paste a service_role key.
# VITE_SUPABASE_URL must be https://ypkfondrkhkydkgovwup.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY is the development publishable/anon key.
VITE_SUPABASE_URL=https://ypkfondrkhkydkgovwup.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server and tooling only. Do not add the VITE_ prefix to these names.
# SUPABASE_ANON_KEY is the same anon/publishable key, for scripts that do not use Vite.
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Keep it on the server.
# SUPABASE_ACCESS_TOKEN is a personal access token from Account → Access Tokens.
SUPABASE_URL=https://ypkfondrkhkydkgovwup.supabase.co
SUPABASE_PROJECT_REF=ypkfondrkhkydkgovwup
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
